# ==============================================================================
#  PT PLN Nusantara Power Services - Divisi TDC
#  Template Konfigurasi Lingkungan (Environment Variables)
# ==============================================================================

CI_ENVIRONMENT=development

# Aplikasi
APP_NAME="Sistem Reservasi Ruangan TDC - PT PLN NPS"
APP_BASE_URL="http://localhost:8080/"
APP_COMPANY="PT PLN NPS"
APP_WEBSITE="https://www.pln-npservices.com"
APP_VERSION="v2.0"
PORT=8080

# Masa berlaku token JWT (milidetik: 28800000 = 8 jam)
JWT_TIME_TO_LIVE=28800000

# Konfigurasi Database
# Default: SQLite lokal (zero-config, otomatis menggunakan backend/writable/tdc_database.db)
# Untuk beralih ke PostgreSQL / MySQL, atur variabel DATABASE_URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/tdc_reservasi
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/tdc_reservasi
DATABASE_URL=

# Konfigurasi Notifikasi Email (SMTP)
# Dapat juga dikonfigurasi melalui Dashboard Admin -> Pengaturan Sistem
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=tdc.reservasi@pln-npservices.com
SMTP_FROM_NAME="Training Development Center (TDC) PT PLN NPS"
SMTP_MOCK=false
